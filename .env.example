# Скопируйте в .env и заполните. .env в git не коммитится (см. .gitignore).
# Домен веб-интерфейса и почты
CORVEX_DOMAIN=mail.company.local
CORVEX_MAIL_DOMAIN=company.local
# Optional comma-separated browser origins; empty = derive https://$CORVEX_DOMAIN
CORVEX_WEB_ORIGINS=
# Первый суперадминистратор (создаётся один раз на пустой базе).
# Пароль пустой = сгенерировать и один раз напечатать в лог: docker compose logs auth-service | grep BOOTSTRAP
CORVEX_BOOTSTRAP_ADMIN_USERNAME=admin
CORVEX_BOOTSTRAP_ADMIN_PASSWORD=
CORVEX_BOOTSTRAP_ADMIN_EMAIL=admin@company.local
# Название общекорпоративного публичного канала, который chat-service создаёт и подключает всем сотрудникам
CORVEX_CHAT_GENERAL_ROOM_TITLE=Общий
# Файлы чата: 25 MiB по умолчанию; AV_REQUIRED=true означает fail-closed при недоступном ClamAV
CORVEX_CHAT_FILE_MAX_BYTES=26214400
CORVEX_CHAT_FILE_AV_REQUIRED=true
# SMTP stays OFF until the Stage 2 Maven/Docker smoke passes (see docs/READINESS.md)
CORVEX_SMTP_ENABLED=false
# Stage 3 protocols stay OFF until the Maven build and client smoke pass (docs/READINESS.md)
CORVEX_POP3_ENABLED=false
# Plain POP3 (110) exposes the password in clear text; enable only consciously on a test stand
CORVEX_POP3_PLAIN_ENABLED=false
# PKCS12 bundle for POP3 implicit TLS 995 inside the certs volume + its password (see service README)
CORVEX_POP3_KEYSTORE_PATH=/certs/pop3.p12
CORVEX_POP3_KEYSTORE_PASSWORD=
CORVEX_IMAP_ENABLED=false
# IMAP 143 = plain listener + STARTTLS (needs TLS material below), 993 = implicit TLS (needs TLS material)
CORVEX_IMAP_PLAIN_ENABLED=true
CORVEX_IMAP_STARTTLS=true
CORVEX_IMAP_TLS_ENABLED=true
CORVEX_IMAP_REQUIRE_TLS_FOR_AUTH=false
# PKCS12 bundle for IMAP STARTTLS/993 inside the certs volume + its password (see service README).
# If the file is absent, 993 is skipped with a warning and 143 starts without STARTTLS (local testing only).
CORVEX_IMAP_KEYSTORE_PATH=/certs/imap.p12
CORVEX_IMAP_KEYSTORE_PASSWORD=
CORVEX_IMAP_KEYSTORE_TYPE=PKCS12
# Outbound STARTTLS is used whenever the receiving MX offers it; set true to require it.
CORVEX_SMTP_REQUIRE_STARTTLS=false
CORVEX_DKIM_SELECTOR=corvex1
CORVEX_CERTS_DIR=./infra/certs
CORVEX_SECRETS_DIR=./infra/secrets

# Секреты: сгенерировать длинными случайными значениями (см. docs/08, шаг 5)
POSTGRES_USER=corvex
POSTGRES_PASSWORD=change-me-strong-password
RABBITMQ_USER=corvex
RABBITMQ_PASSWORD=change-me-strong-password
REDIS_PASSWORD=change-me-strong-password
ELASTIC_PASSWORD=change-me-strong-password
GRAFANA_PASSWORD=change-me-strong-password
CORVEX_TOTP_ENC_KEY=base64-32-byte-key-for-aes-gcm
CORVEX_INTERNAL_API_TOKEN=change-me-strong-password

# Active Directory (оставить пустым, если только локальные учётные записи)
CORVEX_LDAP_URL=ldaps://dc01.company.local:636
CORVEX_LDAP_BASE=DC=company,DC=local

# Алерты мониторинга — рекомендуется внешний ящик и резервный SMTP,
# чтобы уведомление о падении Corvex не зависело от самого Corvex
CORVEX_ALERT_RECIPIENTS=admin@company.local
ALERT_SMTP_HOST=smtp.provider.example
