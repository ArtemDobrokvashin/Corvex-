            <plugin>
                <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.16</version>
                <executions>
                    <execution><goals><goal>prepare-agent</goal></goals></execution>
                    <execution><id>report</id><phase>verify</phase><goals><goal>report</goal><goal>check</goal></goals>
                        <configuration><rules><rule><element>BUNDLE</element><limits>
                            <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.00</minimum></limit>
                        </limits></rule></rules></configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!-- Only the forked Surefire JVM receives the synthetic lab CA. Maven
         itself retains its normal trust store for dependency downloads. -->
    <profiles>
        <profile>
            <id>james-live-lab</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <javax.net.ssl.trustStore>${james.live.truststore}</javax.net.ssl.trustStore>
                                <javax.net.ssl.trustStorePassword>${james.live.truststore.password}</javax.net.ssl.trustStorePassword>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
