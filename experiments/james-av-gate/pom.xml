<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ru.corvex.experimental</groupId>
  <artifactId>james-av-gate</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <james.version>3.9.1</james.version>
  </properties>
  <dependencies>
    <!-- James declares its mailet and core dependencies provided; list them explicitly. -->
    <dependency><groupId>org.apache.james</groupId><artifactId>apache-james-clamav</artifactId><version>${james.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.james</groupId><artifactId>apache-mailet-api</artifactId><version>${james.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.james</groupId><artifactId>apache-mailet-base</artifactId><version>${james.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.james</groupId><artifactId>james-server-core</artifactId><version>${james.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.eclipse.angus</groupId><artifactId>jakarta.mail</artifactId><version>2.0.5</version><scope>provided</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin>
    <!-- Keep the official parent mailet separate: never shade James classes into the extension. -->
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version>
      <executions><execution><id>copy-clamav-parent</id><phase>package</phase><goals><goal>copy</goal></goals>
        <configuration><artifactItems><artifactItem>
          <groupId>org.apache.james</groupId><artifactId>apache-james-clamav</artifactId><version>${james.version}</version>
          <type>jar</type><outputDirectory>${project.build.directory}/extension-deps</outputDirectory>
        </artifactItem></artifactItems></configuration>
      </execution></executions>
    </plugin>
  </plugins></build>
</project>
