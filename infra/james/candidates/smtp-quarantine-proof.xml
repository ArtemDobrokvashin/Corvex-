<?xml version="1.0" encoding="UTF-8"?>
<!--
  NOT MOUNTED OR ENABLED. Single-use quarantine-proof candidate for the laptop.
  Binds James container loopback only: no published port, no cross-container
  reachability, no relay for other hosts. SMTP is plaintext and may relay from
  loopback; never mount this for real users or production. The active config
  stays infra/james/protocols/smtpserver.xml (empty).
-->
<smtpservers>
    <smtpserver enabled="true">
        <jmxName>synthetic-quarantine-smtp</jmxName>
        <bind>127.0.0.1:2525</bind>
        <connectiontimeout>30</connectiontimeout>
        <connectionLimit>8</connectionLimit>
        <connectionLimitPerIP>8</connectionLimitPerIP>
        <auth>
            <announce>never</announce>
            <requireSSL>false</requireSSL>
            <plainAuthEnabled>false</plainAuthEnabled>
        </auth>
        <authorizedAddresses>127.0.0.1/32</authorizedAddresses>
        <verifyIdentity>true</verifyIdentity>
        <!-- James 3.9.1 parses bare values in KiB: 51200 KiB = 50 MiB. -->
        <maxmessagesize>51200</maxmessagesize>
        <addressBracketsEnforcement>true</addressBracketsEnforcement>
        <handlerchain coreHandlersPackage="org.apache.james.smtpserver.NoAuthCmdHandlerLoader">
            <handler class="org.apache.james.smtpserver.fastfail.ValidRcptHandler"/>
        </handlerchain>
    </smtpserver>
</smtpservers>
